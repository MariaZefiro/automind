{
  "name": "automind",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w @automind/api",
    "dev:web": "npm run dev -w @automind/web",
    "build": "npm run build -w @automind/api && npm run build -w @automind/web",
    "test": "npm run test -w @automind/api",
    "admin:create": "dotenv -e .env -- npm run admin:create -w @automind/api",
    "db:generate": "dotenv -e .env -- npm run prisma:generate -w @automind/api",
    "db:migrate": "dotenv -e .env -- npm run prisma:migrate -w @automind/api"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0"
  },
  "allowScripts": {
    "@nestjs/core@10.4.22": true,
    "@prisma/client@6.19.3": true,
    "argon2@0.41.1": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.25.12": true
  }
}
